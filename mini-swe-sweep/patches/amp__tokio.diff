+#[test]
+fn size_hint_overflow() {
+    let mut map = StreamMap::new();
+
+    map.insert("a", stream::iter(0..usize::MAX));
+    map.insert("b", stream::iter(0..usize::MAX));
+
+    let size_hint = map.size_hint();
+    assert_eq!(size_hint, (usize::MAX, None));
